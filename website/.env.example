# Public API base URL (must include /api suffix)
# Local:  http://localhost:5000/api
# Render: https://YOUR_RENDER_SERVICE.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps (Places / Maps used by address picker)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Google OAuth Web Client ID (must match backend GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
