# API base URL (must include /api suffix)
# Local emulator iOS:     http://localhost:5000/api
# Local emulator Android: http://10.0.2.2:5000/api
# Physical device (LAN):  http://YOUR_LAN_IP:5000/api
# Production (Render):    https://YOUR_RENDER_SERVICE.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

