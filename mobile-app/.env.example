# API base URL (must include /api suffix)
# Local emulator iOS:     http://localhost:5000/api
# Local emulator Android: http://10.0.2.2:5000/api
# Physical device (LAN):  http://YOUR_LAN_IP:5000/api
# Production (Render):    https://YOUR_RENDER_SERVICE.onrender.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps (mobile address / map screens)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Google OAuth — Web client ID (ID token audience must be accepted by backend GOOGLE_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional platform-specific clients
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
