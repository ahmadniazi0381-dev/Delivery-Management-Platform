PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="7d"

# Twilio SMS Configurations
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="your_twilio_phone_number"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"

# Payment Webhook Secrets (required — server refuses to start if any are missing)
JAZZCASH_WEBHOOK_SECRET="dev-jazzcash-secret-change-me"
EASYPAISA_WEBHOOK_SECRET="dev-easypaisa-secret-change-me"
SAFEPAY_WEBHOOK_SECRET="dev-safepay-secret-change-me"

# Checkout / payment behaviour
PAYMENT_PENDING_TIMEOUT_MINUTES=15
PAYMENT_MAX_ATTEMPTS=5
PAYMENT_BLOCK_MINUTES=10
CHECKOUT_EXPIRATION_INTERVAL_MS=60000

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Rate Limiting Configuration
RATE_AUTH_WINDOW_MS=900000
RATE_AUTH_MAX=10
RATE_OTP_WINDOW_MS=600000
RATE_OTP_MAX=5
RATE_PUBLIC_WINDOW_MS=60000
RATE_PUBLIC_MAX=120
RATE_USER_WINDOW_MS=60000
RATE_USER_MAX=200
RATE_OWNER_WINDOW_MS=60000
RATE_OWNER_MAX=300
RATE_CHECKOUT_WINDOW_MS=60000
RATE_CHECKOUT_MAX=10
RATE_PAYMENT_WINDOW_MS=60000
RATE_PAYMENT_MAX=20
RATE_WEBHOOK_WINDOW_MS=60000
RATE_WEBHOOK_MAX=100
RATE_REVIEW_WINDOW_MS=3600000
RATE_REVIEW_MAX=5
RATE_PROFILE_WINDOW_MS=900000
RATE_PROFILE_MAX=10
RATE_SEARCH_WINDOW_MS=60000
RATE_SEARCH_MAX=60

