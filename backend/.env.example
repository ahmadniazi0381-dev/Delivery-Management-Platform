PORT=5000
NODE_ENV=development

# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# Use the Direct connection (db.*.supabase.co:5432) OR Session pooler (:5432)
# for both URLs when possible. Prisma migrate needs a non-transaction-pooler URL.
#
# If you use the Transaction pooler (port 6543) for DATABASE_URL, set DIRECT_URL
# to the Direct/Session URL (port 5432). Otherwise set both to the same URL.
#
# Direct:  postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Session: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# Tx pool: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

JWT_SECRET="your_jwt_secret_change_me_in_production"
JWT_EXPIRES_IN="7d"

# Comma-separated allowed frontend origins (production CORS)
# Include your Vercel URL(s). Mobile apps typically send no Origin and are allowed.
# Localhost is included for development.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://YOUR_VERCEL_APP.vercel.app"

# Public URLs used for payment gateway callbacks / redirects (set on Render)
PUBLIC_API_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

# Twilio SMS
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="your_twilio_phone_number"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Google Maps (server-side if used)
GOOGLE_MAPS_API_KEY=""

# Shop GPS
SHOP_LATITUDE=31.4475531
SHOP_LONGITUDE=74.2690347
SHOP_MAX_DELIVERY_KM=2.2

# Payment Webhook Secrets (required — server refuses to start if any are missing)
JAZZCASH_WEBHOOK_SECRET="dev-jazzcash-secret-change-me"
EASYPAISA_WEBHOOK_SECRET="dev-easypaisa-secret-change-me"
SAFEPAY_WEBHOOK_SECRET="dev-safepay-secret-change-me"

# Checkout / payment behaviour
PAYMENT_PENDING_TIMEOUT_MINUTES=15
PAYMENT_MAX_ATTEMPTS=5
PAYMENT_BLOCK_MINUTES=10
CHECKOUT_EXPIRATION_INTERVAL_MS=60000

# Optional app metadata
APP_VERSION="1.0.0"

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Rate Limiting Configuration
RATE_AUTH_WINDOW_MS=900000
RATE_AUTH_MAX=10
RATE_OTP_WINDOW_MS=600000
RATE_OTP_MAX=5
RATE_PUBLIC_WINDOW_MS=60000
RATE_PUBLIC_MAX=120
RATE_USER_WINDOW_MS=60000
RATE_USER_MAX=200
RATE_OWNER_WINDOW_MS=60000
RATE_OWNER_MAX=300
RATE_CHECKOUT_WINDOW_MS=60000
RATE_CHECKOUT_MAX=10
RATE_PAYMENT_WINDOW_MS=60000
RATE_PAYMENT_MAX=20
RATE_WEBHOOK_WINDOW_MS=60000
RATE_WEBHOOK_MAX=100
RATE_REVIEW_WINDOW_MS=3600000
RATE_REVIEW_MAX=5
RATE_PROFILE_WINDOW_MS=900000
RATE_PROFILE_MAX=10
RATE_SEARCH_WINDOW_MS=60000
RATE_SEARCH_MAX=60
